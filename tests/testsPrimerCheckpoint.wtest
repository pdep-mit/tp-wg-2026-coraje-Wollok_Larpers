import player.*
import inventario.*
import llave.*
import disfraces.*
import movimientos.*
import escenarios.*
import puertas.*

describe "Tests sobre Inventario" {
  test "Una mochila recien creada no tiene ningún objeto" {
    assert.that(mochila.objetos().isEmpty())
  }
  
  test "Una mochila vacia no contiene la llave en principio" {
    assert.notThat(mochila.contiene(llave))
  }
  
  test "Al pasar por la llave, esta se agrega al inventario del Jugador" {
    game.addVisual(player)
    game.addVisual(llave)
    llave.chocarConJugador()
    assert.that(player.tiene(llave))
  }
  
  test "Despues de agregar un objeto al inventario, el jugador lo tiene" {
    player.agregarAlInventario(disfrazAnubis)
    assert.that(player.tiene(disfrazAnubis))
  }
}

describe "Tests sobre jugador" {
  test "El jugador empieza sin disfraz" {
    assert.equals(sinDisfraz, player.disfraz())
  }
  
  test "Recoger el activador de un disfraz lo da, pero no se lo pone solo" {
    game.addVisual(player)
    game.addVisual(activadorAnubis)
    activadorAnubis.chocarConJugador()
    assert.that(player.tiene(disfrazAnubis))
    assert.equals(sinDisfraz, player.disfraz())
  }
}

describe "Tests Movimientos" {
  test "Al moverse hacia arriba, el jugador sube una celda" {
    game.width(10)
    game.height(10)
    player.position(game.at(5, 4))
    movimientos.mover(player, haciaArriba)
    assert.equals(game.at(5, 5), player.position())
  }
  
  test "En el borde de la habitacion, el jugador no puede moverse hacia afuera" {
    player.position(game.at(1, 5))
    movimientos.mover(player, haciaLaIzquierda)
    assert.equals(game.at(1, 5), player.position())
  }
}

describe "Tests para la llave final" {
  test "Al agarrar la llave y chocar con la puerta, se gana" {
    game.addVisual(player)
    game.addVisual(llave)
    game.addVisual(puertaFinal)

    llave.chocarConJugador()
    puertaFinal.chocarConJugador()
    assert.that(puertaFinal.gano())
  }
}