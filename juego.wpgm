import wollok.game.*
import escenarios.*

program EscapeDelMuseo {
    game.title("Grupo: Wollok Larpers | Una tarde en el museo")
    game.height(10)
    game.width(10)
    game.cellSize(50)
    
    //El administrador se encarga de todo el setup inicial
    administradorDeSalas.iniciar()
    
    game.start()
}